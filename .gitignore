# Gradleのキャッシュや生成物はリポジトリに含めない
HELP.md
.gradle
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Eclipse/STSが生成する個人環境の設定や一時ファイルは共有しない
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# IntelliJ IDEA固有のワークスペース設定やビルド生成物は共有しない
.idea
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

# NetBeans固有の個人設定やビルド生成物は共有しない
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# VS Code固有の個人設定は共有しない
.vscode/
